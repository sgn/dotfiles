#!/bin/sh

: "${BINPKGS:=${HOME}/src/void-packages/hostdir/binpkgs}"
: "${PRIVKEY:=${HOME}/.ssh/id_rsa}"
: "${SIGNER:=ĐOÀN Trần Công Danh <congdanhqx@gmail.com>}"

force=
debug=
while test $# -ne 0; do
	case "$1" in
		-f|--force) force=yes ;;
		-d|--debug) debug=yes ;;
	esac
	shift
done

cd "${BINPKGS}"

find . \( -type d -path './*' -prune \) -o \
	-name '*.noarch.xbps' -prune -o \
	-name '*.xbps' -print |
	sed -e 's/^.*[.]\([^.]*.\)[.]xbps$/\1/p' |
	sort -u |
	# sort | uniq |
	while read -r _arch; do
		echo "Initializing siging repository for $_arch"
		env XBPS_TARGET_ARCH="$_arch" xbps-rindex \
			${force:+--force} \
			${debug:+--debug} \
			${PRIVKEY:+--privkey "$PRIVKEY"} \
			--sign --signedby "$SIGNER" \
			.
	done
