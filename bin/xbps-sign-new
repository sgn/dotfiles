#!/bin/sh

: "${BINPKGS:=${HOME}/src/void-packages/hostdir/binpkgs}"

debug=
while test $# -ne 0; do
	case "$1" in
		-d|--debug) debug=yes ;;
	esac
	shift
done

cd "$BINPKGS"

# Don't use globs, there's a max length for argument
find . \( -type d -path './*' -prune \) -o \
	-name '*.xbps' -print -o \
	-name '*.xbps.sig2' -print |
	sed 's,[.]/,,; s/[.]sig2$//' |
	sort |
	uniq -u |
	xargs xbps-rindex ${debug:+-d} --sign-pkg \
		${PRIVKEY:+--privkey "$PRIVKEY"}
